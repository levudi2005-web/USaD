MARIADB_DATABASE=usad_dev
MARIADB_USER=usad_app
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-random-password

# Keep the username, password, host, and database aligned with the values above.
# URL-encode any reserved characters in the password.
DATABASE_URL=mysql+pymysql://usad_app:replace-with-a-long-random-password@mariadb:3306/usad_dev

# Replace these placeholders locally; never commit the resulting .env file.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
INITIAL_ADMIN_USERNAME=local-admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
INITIAL_ADMIN_EMAIL=local-admin@example.test
